# Copy to .env and fill in. Never commit .env.
APP_ENV=production
POSTGRES_PASSWORD=change-me
# Generate with: python -m backend.manage gen-kek   (rotate: prepend a new id:key, deploy, run `manage rewrap`)
KEKS=k1:REPLACE_WITH_BASE64_32_BYTE_KEY
AUTH_MODE=oidc
OIDC_ISSUER=https://your-idp.example.com/
OIDC_AUDIENCE=llm-agent-api
OIDC_JWKS_URL=https://your-idp.example.com/.well-known/jwks.json
LOG_LEVEL=INFO
WEB_CONCURRENCY=2
# Optional tuning
# DB_POOL_SIZE=10
# THREADPOOL_SIZE=100
# KEY_SAVES_PER_MINUTE=10
# EXECUTIONS_PER_MINUTE=30
